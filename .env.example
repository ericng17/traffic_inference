# Copy to .env. Secrets are read at runtime, never included in messages/specs.
DATABASE_URL=postgresql://traffic:traffic_local@127.0.0.1:55432/traffic
POSTGRES_PORT=55432
POSTGRES_PASSWORD=traffic_local
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_PORT=19092
KAFKA_LOG_GENERATION=local-v1
HF_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
OBJECT_STORE_ENDPOINT=
# Optional Kafka SSL/SASL properties file; credentials stay outside database.
KAFKA_CLIENT_CONFIG=
RAY_ADDRESS=
RAY_OBJECT_STORE_BYTES=134217728
CONTAINER_DIGEST=development
PIPELINE_CONFIG=configs/example.yaml
RUN_ID=hcm-yolov8s-roi-run1
# Seven IDs verified via Hugging Face API on 2026-11-22; revisions pinned during discovery.
HF_REPO_IDS='["ericng17/hcm_traffic_snapshots","ericng17/hcm_traffic_snapshots2","ericng17/hcm_traffic_snapshots3","ericng17/hcm_traffic_snapshots4","ericng17/hcm_traffic_snapshots5","ericng17/hcm_traffic_snapshots6","ericng17/hcm_traffic_snapshots7"]'
SOURCE_CONFIG_URI=configs/sources.json
DISCOVERY_URI=var/discovery/report.json
MANIFEST_BASE_URI=data/manifests
OUTPUT_BASE_URI=data/output
WEIGHTS_URI=
WEIGHTS_SHA256=
ROI_URI=
ROI_SHA256=
CAMERA_MAPPING_URI=
CAMERA_MAPPING_SHA256=
CACHE_DIR=var/cache
CACHE_MAX_BYTES=150000000000
BACKUP_DIR=var/backups
BACKUP_BASE_URI=
BACKUP_INTERVAL_SECONDS=3600
PG_DUMP_BIN=pg_dump
RESTORE_DATABASE_URL=
RESTORE_DUMP=
SMOKE_DIR=var/smoke
SAMPLE_MANIFEST_URI=
