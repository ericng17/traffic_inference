FROM ghcr.io/astral-sh/uv:0.6.9 AS uv
FROM postgres:17.4-bookworm AS pgtools
FROM python:3.12.9-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=pgtools /usr/lib/postgresql/17/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pgtools /usr/lib/postgresql/17/bin/pg_restore /usr/local/bin/pg_restore
COPY --from=pgtools /usr/lib/x86_64-linux-gnu/libpq.so.5* /usr/local/lib/
RUN apt-get update && apt-get install -y --no-install-recommends libldap-2.5-0 libgssapi-krb5-2 libzstd1 liblz4-1 && ldconfig && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra dev --extra ray --no-install-project --no-cache
COPY src ./src
RUN uv sync --frozen --extra dev --extra ray --no-cache
COPY configs ./configs
COPY tests ./tests
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
CMD ["traffic-pipeline", "--help"]
